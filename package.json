{
  "name": "ketyap-ui",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "pnpm check:ui-base && pnpm registry:build && next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "registry:build": "shadcn build registry.json --output ./public/r && node scripts/prune-registry.mjs",
    "postinstall": "fumadocs-mdx",
    "check": "pnpm check:ui-base && ultracite check",
    "fix": "ultracite fix",
    "prepare": "lefthook install",
    "check:ui-base": "node scripts/check-ui-base.mjs"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@untitledui/icons": "^0.0.23",
    "@vercel/analytics": "^2.0.1",
    "@web-kits/audio": "^0.2.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "fumadocs-core": "16.15.12",
    "fumadocs-mdx": "^15.4.3",
    "jiti": "^2.7.0",
    "jotai": "^3.0.0",
    "lru-cache": "^11.5.3",
    "lucide-react": "1.47.0",
    "motion": "13.4.0",
    "next": "16.3.5",
    "next-themes": "0.4.6",
    "postcss": "^8.5.28",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-hotkeys-hook": "^5.3.3",
    "rehype-pretty-code": "^0.14.5",
    "shiki": "^4.4.3",
    "tailwind-merge": "^3.7.0",
    "web-haptics": "^0.0.6",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.3.3",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.6.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "lefthook": "^2.1.14",
    "oxfmt": "^0.70.0",
    "oxlint": "^1.85.0",
    "shadcn": "4.21.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^7.0.2",
    "ultracite": "7.12.0"
  },
  "engines": {
    "node": ">=24.11.0"
  },
  "packageManager": "pnpm@11.22.0"
}
